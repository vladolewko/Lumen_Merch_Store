@model IEnumerable<Lumen_Merch_Store.Areas.Admin.ViewModels.UniverseViewModel>

@{
    ViewData["Title"] = "Всесвіти";
    Layout = "~/Areas/Admin/Views/_Shared/_AdminLayout.cshtml";
}

<div class="flex justify-between mb-4">
    <h2>Управління Всесвітами</h2>
    <a asp-action="Create" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline mr-1" viewBox="0 0 20 20" fill="currentColor" style="width: 1rem; height: 1rem; vertical-align: middle;">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/>
        </svg>
        Новий Всесвіт
    </a>
</div>

<div class="admin-main-content">
    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th style="width: 50px;">ID</th>
                <th>Назва (UA)</th>
                <th style="width: 200px;" class="text-right">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.NameForGrid</td>
                    <td class="text-right">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="text-yellow-400 mr-3 hover:text-yellow-300">Редагувати</a>
                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="text-red-500 hover:text-red-400" onclick="return confirm('Ви впевнені, що хочете видалити цей всесвіт?');">
                                Видалити
                            </button>
                        </form>
                    </td>
                </tr>
            }
             @if (!Model.Any())
            {
                <tr>
                    <td colspan="3" class="text-center text-gray-500">Всесвітів поки немає.</td>
                </tr>
            }
        </tbody>
    </table>
</div>