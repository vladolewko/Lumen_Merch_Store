@model Lumen_Merch_Store.Areas.Admin.ViewModels.CategoryViewModel 
@* ПРИМІТКА: Ми можемо використовувати CategoryViewModel тут, бо структура ідентична (Id + List<Translations>). 
   Або створи окремий UniverseViewModel з такими ж полями, якщо плануєш розширювати. *@

@{
    ViewData["Title"] = Model.Id == 0 ? "Створити Всесвіт" : "Редагувати Всесвіт";
    Layout = "~/Areas/Admin/Views/_Shared/_AdminLayout.cshtml";
}

<div class="admin-main-content">
    <div class="flex justify-between items-center mb-4">
        <h2>@ViewData["Title"]</h2>
    </div>

    <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
        <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4"></div>
        <input type="hidden" asp-for="Id" />
        
        <div class="bg-gray-800 p-4 rounded mb-4 border border-gray-700">
            <h3 class="font-bold text-xl mb-3 text-yellow-400">Інформація та Переклади</h3>
            
            <ul class="nav nav-tabs mb-3" id="univTab" role="tablist">
                @for (int i = 0; i < Model.Translations.Count; i++)
                {
                    var lang = Model.Translations[i].LanguageCode;
                    var isActive = i == 0 ? "active" : "";
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @isActive" id="tab-@lang" data-bs-toggle="tab" data-bs-target="#content-@lang" type="button" role="tab">
                            @lang.ToUpper() @(lang == "uk" ? "🇺🇦" : "🇬🇧")
                        </button>
                    </li>
                }
            </ul>

            <div class="tab-content" id="univTabContent">
                @for (int i = 0; i < Model.Translations.Count; i++)
                {
                    var lang = Model.Translations[i].LanguageCode;
                    var isActive = i == 0 ? "show active" : "";

                    <div class="tab-pane fade @isActive" id="content-@lang" role="tabpanel">
                        <input type="hidden" asp-for="Translations[i].LanguageCode" />
                        
                        <div class="form-group mb-3">
                            <label class="form-label">Назва (@lang.ToUpper())</label>
                            <input asp-for="Translations[i].Name" class="form-control" placeholder="Назва всесвіту..." />
                            <span asp-validation-for="Translations[i].Name" class="text-red-500 text-sm"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Опис (@lang.ToUpper())</label>
                            <textarea asp-for="Translations[i].Description" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="flex justify-end gap-3">
            <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
            <button type="submit" class="btn btn-primary">Зберегти</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}