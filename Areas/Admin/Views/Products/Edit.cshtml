@model Lumen_Merch_Store.Areas.Admin.ViewModels.ProductViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Створити Продукт" : "Редагувати Продукт";
    Layout = "~/Areas/Admin/Views/_Shared/_AdminLayout.cshtml";
}

<div class="admin-main-content">
    <div class="flex justify-between items-center mb-4">
        <h2>@ViewData["Title"]</h2>
    </div>

    <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" />

        <div class="bg-gray-800 p-4 rounded mb-4 border border-gray-700">
             <h3 class="font-bold text-xl mb-3 text-yellow-400">I. Медіа</h3>
             <div class="flex items-center gap-4">
                <div style="width: 100px; height: 120px; background: #333; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" style="width: 100%; height: 100%; object-fit: cover;">
                    }
                    else
                    {
                        <span class="text-xs text-gray-500">No Image</span>
                    }
                </div>
                <div>
                    <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                </div>
             </div>
        </div>

        <div class="bg-gray-800 p-4 rounded mb-4 border border-gray-700">
            <h3 class="font-bold text-xl mb-3 text-yellow-400">II. Інформація</h3>
            
            <ul class="nav nav-tabs mb-3" id="langTab" role="tablist">
                @for (int i = 0; i < Model.Translations.Count; i++)
                {
                    var lang = Model.Translations[i].LanguageCode;
                    var isActive = i == 0 ? "active" : "";
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @isActive" id="tab-@lang" data-bs-toggle="tab" data-bs-target="#content-@lang" type="button" role="tab">
                            @lang.ToUpper() @(lang == "uk" ? "🇺🇦" : "🇬🇧")
                        </button>
                    </li>
                }
            </ul>

            <div class="tab-content" id="langTabContent">
                @for (int i = 0; i < Model.Translations.Count; i++)
                {
                    var lang = Model.Translations[i].LanguageCode;
                    var isActive = i == 0 ? "show active" : "";

                    <div class="tab-pane fade @isActive" id="content-@lang" role="tabpanel">
                        <input type="hidden" asp-for="Translations[i].LanguageCode" />

                        <div class="form-group mb-3">
                            <label class="form-label">Назва (@lang)</label>
                            <input asp-for="Translations[i].Name" class="form-control" />
                            <span asp-validation-for="Translations[i].Name" class="text-red-500 text-sm"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Короткий опис</label>
                            <textarea asp-for="Translations[i].ShortDescription" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Повний опис</label>
                            <textarea asp-for="Translations[i].FullDescription" class="form-control" rows="5"></textarea>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="bg-gray-800 p-4 rounded mb-4 border border-gray-700">
            <h3 class="font-bold text-xl mb-3 text-yellow-400">III. Налаштування</h3>
            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="Price">Ціна</label>
                    <input asp-for="Price" class="form-control" />
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="Stock">Склад</label>
                    <input asp-for="Stock" class="form-control" />
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="CategoryId">Категорія</label>
                    <select asp-for="CategoryId" asp-items="@Model.Categories" class="form-control"></select>
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="UniverseId">Всесвіт</label>
                    <select asp-for="UniverseId" asp-items="@Model.Universes" class="form-control"></select>
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3">
            <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
            <button type="submit" class="btn btn-primary">Зберегти</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}