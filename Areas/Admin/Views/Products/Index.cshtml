@model IEnumerable<Lumen_Merch_Store.Areas.Admin.ViewModels.ProductViewModel>
@{
    ViewData["Title"] = "Продукти";
    Layout = "~/Areas/Admin/Views/_Shared/_AdminLayout.cshtml";
}

<div class="flex justify-between mb-4">
    <h2>Управління продуктами</h2>
    <a asp-action="Create" class="btn btn-primary">+ Новий продукт</a>
</div>

<div class="admin-main-content">
    <table class="table table-dark table-striped">
        <thead>
        <tr>
            <th>IMG</th>
            <th>Назва (UK)</th>
            <th>Ціна</th>
            <th>Запас</th>
            <th>Дії</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if(!string.IsNullOrEmpty(item.ImageUrl)) {
                        <img src="@item.ImageUrl" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;">
                    }
                </td>
                <td>@item.NameForGrid</td>
                <td>@item.Price.ToString("C")</td>
                <td>@item.Stock</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-yellow-400 mr-2">Редагувати</a>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="text-red-500" onclick="return confirm('Видалити?');">Видалити</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>