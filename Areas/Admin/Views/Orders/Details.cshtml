@model Lumen_Merch_Store.Areas.Admin.ViewModels.OrderDetailViewModel
@using Lumen_Merch_Store.Models.Enums

@{
    ViewData["Title"] = $"Order #{Model.Id}";
    Layout = "~/Areas/Admin/Views/_Shared/_AdminLayout.cshtml";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary">← Back to Orders</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <!-- Order Items -->
        <div class="card mb-4" style="background-color: var(--surface-color); border: 1px solid #333;">
            <div class="card-header" style="background-color: #242424; border-bottom: 1px solid #333;">
                <h5 class="mb-0">Order Items</h5>
            </div>
            <div class="card-body p-0">
                <table class="mb-0">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Image</th>
                            <th>Product</th>
                            <th>Size</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Price</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(item.ProductImage) ? "https://placehold.co/60x60/1E1E1E/FACC15.png?text=P" : item.ProductImage)" 
                                         alt="@item.ProductName" 
                                         style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;">
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", "Products", new { area = "Admin", id = item.ProductId })">
                                        @item.ProductName
                                    </a>
                                </td>
                                <td>@(item.SizeName ?? "-")</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.Price.ToString("N2") ₴</td>
                                <td class="text-end"><strong>@item.Total.ToString("N2") ₴</strong></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot style="background-color: #242424;">
                        <tr>
                            <td colspan="5" class="text-end"><strong>Order Total:</strong></td>
                            <td class="text-end"><strong style="color: var(--primary-accent);">@Model.Total.ToString("N2") ₴</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Customer Info -->
        <div class="card mb-4" style="background-color: var(--surface-color); border: 1px solid #333;">
            <div class="card-header" style="background-color: #242424; border-bottom: 1px solid #333;">
                <h5 class="mb-0">Customer Information</h5>
            </div>
            <div class="card-body">
                <p class="mb-2"><strong>Name:</strong> @Model.CustomerName</p>
                <p class="mb-2"><strong>Email:</strong> @Model.CustomerEmail</p>
                <p class="mb-0"><strong>Phone:</strong> @(Model.CustomerPhone ?? "Not provided")</p>
            </div>
        </div>

        <!-- Order Status -->
        <div class="card mb-4" style="background-color: var(--surface-color); border: 1px solid #333;">
            <div class="card-header" style="background-color: #242424; border-bottom: 1px solid #333;">
                <h5 class="mb-0">Order Status</h5>
            </div>
            <div class="card-body">
                <p class="mb-2"><strong>Order Date:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                <p class="mb-3">
                    <strong>Current Status:</strong>
                    @{
                        var badgeClass = Model.Status switch
                        {
                            OrderStatus.Pending => "bg-warning text-dark",
                            OrderStatus.Paid => "bg-info",
                            OrderStatus.Shipped => "bg-primary",
                            OrderStatus.Completed => "bg-success",
                            OrderStatus.Cancelled => "bg-danger",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @badgeClass">@Model.Status</span>
                </p>

                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Change Status</label>
                        <select name="status" class="form-control" style="background-color: var(--bg-dark); color: var(--text-light); border: 1px solid #333;">
                            @foreach (OrderStatus status in ViewBag.Statuses)
                            {
                                <option value="@status" selected="@(Model.Status == status)">@status</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Update Status</button>
                </form>
            </div>
        </div>

        <!-- Danger Zone -->
        <div class="card" style="background-color: var(--surface-color); border: 1px solid #dc3545;">
            <div class="card-header" style="background-color: rgba(220, 53, 69, 0.1); border-bottom: 1px solid #dc3545;">
                <h5 class="mb-0 text-danger">Danger Zone</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">Deleting an order is permanent and cannot be undone.</p>
                <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this order? This action cannot be undone.');">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger w-100">Delete Order</button>
                </form>
            </div>
        </div>
    </div>
</div>
