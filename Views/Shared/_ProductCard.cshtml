@model Lumen_Merch_Store.ViewModels.ProductCardViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using Lumen_Merch_Store.Resources 

@inject IStringLocalizer<Catalogue> Catalogue

@if (Model != null)
{
    <div class="product-card">
        <a href="@Url.Action("Product", "Catalogue", new { id = Model.Id })">
            <img 
                src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://placehold.co/300x400/1E1E1E/FACC15.png?text=Product" : Model.ImageUrl)" 
                alt="@(Model.Name ?? Catalogue["Untitled"].Value)" 
                class="product-image">
        </a>
        <div class="product-info">
            <span class="product-universe">@(Model.UniverseName ?? Catalogue["UnknownUniverse"].Value)</span>
            <h4 class="product-name">@(Model.Name ?? Catalogue["Untitled"].Value)</h4>
            <p class="product-price">@(Model.Price.ToString("F2")) ₴</p>
            
            <button class="btn btn-primary btn-sm w-100" data-product-id="@Model.Id">
                @Catalogue["Product_AddToCart"]
            </button>
        </div>
    </div>
}