@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Lumen_Merch_Store.Resources 

@inject SignInManager<ApplicationUser> SignInManager
@inject IStringLocalizer<General> General
@inject IStringLocalizer<Catalogue> Catalogue

@{
    // Отримуємо поточну культуру
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCultureCode = requestCulture?.RequestCulture.UICulture.TwoLetterISOLanguageName ?? "uk";

    // Формуємо URL для повернення
    var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"{Context.Request.Path.Value}{Context.Request.QueryString}";
}

<!DOCTYPE html>
<html lang="@currentCultureCode">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Lumen Store</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Lato:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/lumen-styles.css"/>
</head>
<body>
<header class="main-header">
    <nav class="container main-nav">
        <a class="logo" asp-area="" asp-controller="Home" asp-action="Index">LUMEN</a>

        <ul class="nav-menu">
            <li><a asp-area="" asp-controller="Home" asp-action="Index">@General["Home"]</a></li>
            
            <li class="dropdown">
                <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown">@Catalogue["Title"]</a>
                <ul class="dropdown-menu bg-black">
                    <li><a class="dropdown-item" asp-area="" asp-controller="Catalogue" asp-action="Products">@Catalogue["All"]</a></li>
                    <li><a class="dropdown-item" asp-area="" asp-controller="Catalogue" asp-action="Categories">@Catalogue["FilterTitle_Categories"]</a></li>
                    <li><a class="dropdown-item" asp-area="" asp-controller="Catalogue" asp-action="Universes">@Catalogue["FilterTitle_Universes"]</a></li>
                </ul>
            </li>

            <li><a asp-area="" asp-controller="Home" asp-action="Privacy">@General["AboutUs"]</a></li>
        </ul>

        <div class="nav-actions">
            <div class="language-selector">
                <form id="langForm" asp-controller="Home" asp-action="SetLanguage" asp-route-returnUrl="@returnUrl" method="post">
                    <select name="culture" class="form-select form-select-sm" onchange="this.form.submit();">
                        @if (currentCultureCode == "en")
                        {
                            <option value="en" selected>EN</option>
                            <option value="uk">UK</option>
                        }
                        else
                        {
                            <option value="en">EN</option>
                            <option value="uk" selected>UK</option>
                        }
                    </select>
                </form>
            </div>
            <div class="nav-icons">
                @{
                    var profileUrl = SignInManager.IsSignedIn(User) ? Url.Action("Profile", "Account") : Url.Action("Login", "Account");
                }

                <a href="@profileUrl" aria-label="Profile">
                     <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                </a>
                <a href="#" aria-label="Wishlist">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
                </a>
                <a href="#" aria-label="Cart">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                </a>
                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <a href="/Admin/Dashboard">@General["AdminPanel"]</a>
                }
            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="footer">
    <div class="container">
        &copy; 2025 - Lumen Store | @General["FooterRights"]
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>