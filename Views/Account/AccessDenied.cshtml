@{
    ViewData["Title"] = General["AccessDenied"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" class="text-danger">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <h1 class="text-danger">@General["AccessDenied"]</h1>
            <p class="text-muted mb-4">@General["AccessDeniedDescription"]</p>
            <a href="/" class="btn btn-primary">@General["BackToHome"]</a>
        </div>
    </div>
</div>

